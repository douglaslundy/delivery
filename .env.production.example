# Copie para .env.production e preencha. Nunca commitar o arquivo real.

# Postgres (usado por docker-compose.yml para montar DATABASE_URL automaticamente)
DB_PASSWORD=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://app.dominio.com

# AES-256-GCM para credenciais por tenant (Evolution API key, etc.) — mesma chave
# em todos os ambientes que leem os mesmos dados criptografados.
CREDENTIALS_KEY=

# Mercado Pago (pagamento online, por tenant via painel — nao global aqui)
# MERCADOPAGO_WEBHOOK_SECRET=

# Caddy / subdominio wildcard
PLATFORM_DOMAIN=dominio.com

# Bind da app (padrao: so localhost, Caddy faz proxy)
APP_BIND=127.0.0.1
APP_PORT=3600
