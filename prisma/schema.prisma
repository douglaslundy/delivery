// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  active    Boolean  @default(true)
  timezone  String   @default("America/Sao_Paulo")
  currency  String   @default("BRL")
  createdAt DateTime @default(now())

  domains    StoreDomain[]
  members    StoreMember[]
  categories      Category[]
  products        Product[]
  classifications ProductClassification[]
  productAddons   ProductAddon[]
  orders          Order[]
  financeCategories FinanceCategory[]
  bankAccounts      BankAccount[]
  financeEntries    FinanceEntry[]
  fiscalDocuments   FiscalDocument[]
}

model StoreDomain {
  id      String @id @default(cuid())
  storeId String
  domain  String @unique

  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model Account {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  memberships  StoreMember[]
}

enum StoreRole {
  OWNER
  MANAGER
  ATTENDANT
  KITCHEN
  DELIVERY
}

model StoreMember {
  id        String    @id @default(cuid())
  accountId String
  storeId   String
  role      StoreRole

  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([accountId, storeId])
  @@index([storeId])
}

model Category {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  position  Int      @default(0)
  active    Boolean  @default(true)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([storeId, id])
  @@index([storeId])
}

model Product {
  id           String   @id @default(cuid())
  storeId      String
  categoryId   String?
  name         String
  description  String   @default("")
  descriptionAiSuggested String?
  photoUrl     String?
  priceCents   Int?
  pricePerKg   Boolean  @default(false)
  active       Boolean  @default(true)
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [storeId, categoryId], references: [storeId, id])
  addons       ProductAddon[]
  classifications ProductClassification[]

  @@unique([storeId, id])
  @@index([storeId])
  @@index([categoryId])
}

model ProductClassification {
  id        String  @id @default(cuid())
  storeId   String
  productId String
  label     String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade)

  @@index([storeId])
  @@index([productId])
}

model ProductAddon {
  id         String  @id @default(cuid())
  storeId    String
  productId  String
  groupName  String
  name       String
  priceCents Int     @default(0)
  required   Boolean @default(false)
  multiple   Boolean @default(false)
  active     Boolean @default(true)
  position   Int     @default(0)

  store      Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade)

  @@index([storeId])
  @@index([productId])
}

enum OrderChannel {
  PDV
  SALAO
  DELIVERY
  AGENDADO
}

enum OrderStatus {
  RECEIVED
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELED
}

model Order {
  id             String       @id @default(cuid())
  storeId        String
  customerId     String?
  channel        OrderChannel
  status         OrderStatus  @default(RECEIVED)
  tableNumber    String?
  scheduledFor   DateTime?
  deliveryAddress Json?
  deliveryId     String?
  subtotalCents  Int
  discountCents  Int          @default(0)
  deliveryFeeCents Int        @default(0)
  totalCents     Int
  paymentMethod  String?
  mpPaymentId    String?
  couponId       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  statusHistory  OrderStatusEvent[]

  @@unique([storeId, id])
  @@index([storeId, status])
}

model OrderItem {
  id          String  @id @default(cuid())
  storeId     String
  orderId     String
  productId   String
  quantity    Int
  unitPriceCents Int
  weightGrams Int?
  addons      Json
  notes       String?

  order       Order   @relation(fields: [storeId, orderId], references: [storeId, id], onDelete: Cascade)

  @@index([storeId])
  @@index([orderId])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  storeId   String
  orderId   String
  status    OrderStatus
  createdAt DateTime    @default(now())
  actorId   String?

  order     Order       @relation(fields: [storeId, orderId], references: [storeId, id], onDelete: Cascade)

  @@index([orderId])
}

model FinanceCategory {
  id      String @id @default(cuid())
  storeId String
  name    String
  kind    String

  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model BankAccount {
  id                  String @id @default(cuid())
  storeId             String
  name                String
  initialBalanceCents Int    @default(0)

  store               Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model FinanceEntry {
  id            String    @id @default(cuid())
  storeId       String
  bankAccountId String?
  categoryId    String?
  orderId       String?
  kind          String
  amountCents   Int
  dueDate       DateTime?
  paidAt        DateTime?
  description   String
  createdAt     DateTime  @default(now())

  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, dueDate])
  @@index([storeId, paidAt])
}

model FiscalDocument {
  id          String    @id @default(cuid())
  storeId     String
  orderId     String
  kind        String
  status      String
  providerRef String?
  issuedAt    DateTime?
  createdAt   DateTime  @default(now())

  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([orderId])
}
